# ============================================
# WhatsApp Business Base — Environment Variables
# ============================================
# Copy this file as .env.local for development

# --- Node ---
NODE_VERSION=20
NODE_ENV=development
LOG_LEVEL=debug

# --- Database (Neon PostgreSQL) ---
DATABASE_URL=postgresql://user:pass@ep-xxx.sa-east-1.aws.neon.tech/whatsapp-base?sslmode=require

# --- Auth (NextAuth v5) ---
AUTH_SECRET=tu-secret-generado-con-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# --- Seed Data ---
ADMIN_PASSWORD=admin123

# --- Rate Limiting (Upstash Redis) ---
# Create a free Redis database at https://console.upstash.com and copy the credentials
UPSTASH_REDIS_REST_URL=https://your-region-xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# --- Encryption ---
# Any string of at least 32 characters; SHA-256 derived to a 256-bit AES key
ENCRYPTION_KEY=your-32-char-min-encryption-key-string

# --- YCloud (WhatsApp Provider) ---
YCLOUD_API_KEY=tu-api-key-de-ycloud
YCLOUD_WEBHOOK_SECRET=tu-webhook-secret-de-ycloud
WHATSAPP_PHONE_NUMBER=5491112345678

# --- AI (OpenAI) ---
OPENAI_API_KEY=sk-tu-openai-api-key

# --- Business Rules ---
DUPLICATE_ORDER_WINDOW_MINUTES=15
