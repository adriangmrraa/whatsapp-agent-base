# ============================================
# WhatsApp Agent Base — Environment Variables
# ============================================
# Copy this file as .env.local for development.
#
# Bootstrap model: env vars are the FALLBACK credentials used until a tenant
# stores its own in the `credentials` table (AES-256 encrypted at rest).
# In multi-tenant production every provider secret should live in the DB.

# --- Node ---
NODE_ENV=development
LOG_LEVEL=debug

# --- Database (PostgreSQL — Neon, Supabase, RDS, local...) ---
DATABASE_URL=postgresql://user:pass@localhost:5432/whatsapp-agent-base

# --- Auth (NextAuth v5) ---
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# --- Encryption ---
# Any string ≥32 chars; SHA-256 derived to an AES-256 key. Rotating this key
# invalidates every encrypted credential in the DB — treat it carefully.
ENCRYPTION_KEY=your-32-char-min-encryption-key-string

# --- Tenancy ---
# Slug of the bootstrap tenant created by `npm run db:seed`. Inbound webhooks
# resolve tenants through the `channels` table; this is only the fallback
# when no channel row matches yet.
DEFAULT_TENANT_SLUG=default
DEFAULT_TENANT_NAME=Default Tenant

# --- Seed admin user ---
ADMIN_PASSWORD=admin123

# --- Rate limiting + message buffer (Upstash Redis) ---
# Optional: without these the buffer falls back to in-memory (dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- YCloud (WhatsApp via BSP) ---
YCLOUD_API_KEY=
YCLOUD_WEBHOOK_SECRET=
WHATSAPP_PHONE_NUMBER=5491112345678

# --- Meta WhatsApp Cloud API (direct, no BSP) ---
# META_APP_ID + META_APP_SECRET power the OAuth "Connect with Meta" flow.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=generate-a-random-string
# Public URL Meta calls back to (OAuth redirect + webhook subscription).
BASE_URL=https://your-domain.com
# After OAuth, the access token is stored per-tenant in `credentials`.
# META_ACCESS_TOKEN is only the env fallback.
META_ACCESS_TOKEN=
# Facebook Page / Instagram messaging use a PAGE access token (Send API
# /me/messages). Falls back to META_ACCESS_TOKEN when unset.
META_PAGE_ACCESS_TOKEN=

# --- Chatwoot (optional human-in-the-loop inbox) ---
CHATWOOT_BASE_URL=https://app.chatwoot.com
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=
# Per-tenant: chatwoot_enabled / chatwoot_inbox_id / chatwoot_mode in agent_config

# --- Telegram (optional channel) ---
TELEGRAM_BOT_TOKEN=

# --- AI provider (any OpenAI-compatible endpoint) ---
# Per-tenant overrides live in agent_config.ai_*; these are the env fallback.
OPENAI_API_KEY=sk-...
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5-mini
AI_MODEL_FAST=gpt-5-nano
AI_MODEL_VISION=gpt-5-mini

# --- Embeddings / vector memory (any OpenAI-compatible /embeddings endpoint) ---
# Per-tenant overrides live in agent_config.embedding_*; these are the fallback.
# Requires the pgvector extension (Neon supports it natively; migration 0002).
# EMBEDDING_DIMENSIONS must match the vector(1536) column — changing it is a migration.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- System One hosted decision layer (optional — Jev/Laya API) ---
# Per-tenant overrides live in agent_config.decision_*; these are the fallback.
# With no key + URL the local rules layer answers and nothing leaves the
# process. DECISION_ENGINE: jev | laya. DECISION_TIMEOUT_MS caps each call —
# on timeout/failure the local rules layer takes over (fail-open for intent).
DECISION_API_KEY=
DECISION_BASE_URL=
DECISION_ENGINE=jev
DECISION_TIMEOUT_MS=800

# --- JEV harness memory (decision-layer context) ---
# The JEV dev-harness memory layer IS Engram; the only choice is WHERE the
# memories live. Switch backends by env — no code change:
#   local  (alias engram) — local Engram server (ENGRAM_HTTP_URL, default
#                           http://127.0.0.1:7437). Default backend.
#   cloud                 — remote Engram server (ENGRAM_CLOUD_URL + token).
#   neon                  — Engram-on-Postgres (jen_memory table via DATABASE_URL).
#   none                  — stateless fail-soft fallback.
# Memory is ADVISORY: an unreachable backend never blocks a decision.
JEV_MEMORY=local
ENGRAM_HTTP_URL=http://127.0.0.1:7437
# ENGRAM_HTTP_TOKEN=
# Remote Engram (only when JEV_MEMORY=cloud):
ENGRAM_CLOUD_URL=
ENGRAM_CLOUD_TOKEN=
# JEV_MEMORY_PROJECT=whatsapp-business-base
# Decision provider key for the harness: JEV_API_KEY (alias TYPESAFE_API_KEY)
# for Jev, or OPENAI_API_KEY for the OpenAI Decisions provider. `npm run onboard
# -- --jev` / `--decisions=openai` persists this; it is never printed.
JEV_API_KEY=
TYPESAFE_API_KEY=

# --- Internal voice agent (OpenAI Realtime API) ---
# Staff-facing speech-to-speech agent. Uses the tenant's OpenAI-pointed AI key
# when available, else REALTIME_API_KEY / OPENAI_API_KEY. The key never reaches
# the browser: the server mints a short-lived ephemeral client secret.
REALTIME_API_KEY=
REALTIME_BASE_URL=https://api.openai.com/v1
REALTIME_MODEL=gpt-4o-realtime-preview
REALTIME_VOICE=alloy

# --- Internal jobs ---
# Bearer token protecting /api/cron/flush (buffer flush). Any random string.
CRON_SECRET=

# --- Business rules ---
DUPLICATE_ORDER_WINDOW_MINUTES=15
